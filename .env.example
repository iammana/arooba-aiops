# ========================================================
# Arooba-AIOps Configuration Environment
# ========================================================

# Telemetry Source: "simulated" (built-in virtual APs) or "hardware" (Raspberry Pi 5)
TELEMETRY_SOURCE=simulated

# Raspberry Pi 5 Edge Telemetry Daemon URL (used when TELEMETRY_SOURCE=hardware)
EDGE_AP_HOST=http://192.168.4.1:8000
EDGE_AP_TIMEOUT_SEC=5.0

# LLM Provider: "mock" (offline rule engine, no API key needed), "gemini", "openai", or "anthropic"
LLM_PROVIDER=mock

# LLM API Keys (fill the one matching your selected provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model overrides (optional)
# GEMINI_MODEL=gemini-1.5-pro
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Web Dashboard Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
